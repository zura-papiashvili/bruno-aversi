meta {
  name: List all entities for given project. Kind should be in cebeb case. Search is not implemented. Supported kinds: request-action, event
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api_admin/v1/project/:projectId/entity/:kind
  body: none
  auth: apikey
}

params:query {
  ~limit: 
  ~page: 
  ~sortBy: 
  ~sortOrder: 
  ~search: 
}

params:path {
  projectId: 
  kind: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_admin/v1/project/:projectId/entity/:kind
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
    }
  
    params:path: {
      projectId: 
      kind: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

