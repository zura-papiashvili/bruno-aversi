meta {
  name: Update the role
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api_admin/v1/auth/role/:id
  body: json
  auth: apikey
}

params:path {
  id: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "name": ""
  }
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_admin/v1/auth/role/:id
    method: PUT
    mode: json
    params:path: {
      id: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "name": ""
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_admin/v1/auth/role/:id
