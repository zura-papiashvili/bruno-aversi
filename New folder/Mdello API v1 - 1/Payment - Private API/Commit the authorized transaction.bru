meta {
  name: Commit the authorized transaction.
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/payment/commit
  body: none
  auth: apikey
}

headers {
  x-private-api-key: {{apiKey}}
}

auth:apikey {
  key: x-private-api-key
  value: {{apiKey}}
  placement: header
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api/v1/payment/commit
    method: POST
    mode: none
    headers: {
      x-private-api-key: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api/v1/payment/commit
    method: POST
    mode: none
    headers: {
      x-private-api-key: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
