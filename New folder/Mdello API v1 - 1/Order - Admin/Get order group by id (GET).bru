meta {
  name: Get order group by id (GET)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api_admin/v1/project/:projectId/ecommerce/order-group/:orderGroupId
  body: none
  auth: apikey
}

params:path {
  orderGroupId: 
  projectId: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_admin/v1/project/:projectId/ecommerce/order-group/:orderGroupId
