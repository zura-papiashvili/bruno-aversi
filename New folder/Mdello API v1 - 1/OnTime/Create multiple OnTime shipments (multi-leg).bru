meta {
  name: Create multiple OnTime shipments (multi-leg)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api_admin/v1/ontime/orders/multi
  body: json
  auth: inherit
}

body:json {
  {
    "orderNumber": "",
    "orderDate": "",
    "trackingPrefix": "",
    "dispatcher": "",
    "baseDescription": "",
    "legs": [
      {
        "pickup": "",
        "dropoff": "",
        "priceSet": "",
        "codAmount": 0,
        "trackingSuffix": "",
        "description": "",
        "shortAddressOverride": ""
      }
    ]
  }
}

