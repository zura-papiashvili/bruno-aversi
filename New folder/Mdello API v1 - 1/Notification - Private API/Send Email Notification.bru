meta {
  name: Send Email Notification
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/notification/email
  body: json
  auth: apikey
}

headers {
  x-private-api-key: {{apiKey}}
}

auth:apikey {
  key: x-private-api-key
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "from": "",
    "fromName": "",
    "to": "",
    "cc": [],
    "subject": "",
    "body": "",
    "bodyHTML": "",
    "attachments": [
      {
        "content": "",
        "type": "",
        "filename": ""
      }
    ]
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api/v1/notification/email
    method: POST
    mode: json
    headers: {
      x-private-api-key: {{apiKey}}
    }
  
    body:json: {
      {
        "from": "",
        "fromName": "",
        "to": "",
        "cc": [],
        "subject": "",
        "body": "",
        "bodyHTML": "",
        "attachments": [
          {
            "content": "",
            "type": "",
            "filename": ""
          }
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Private API key
  
  request: {
    url: {{baseUrl}}/api/v1/notification/email
    method: POST
    mode: json
    headers: {
      x-private-api-key: {{apiKey}}
    }
  
    body:json: {
      {
        "from": "",
        "fromName": "",
        "to": "",
        "cc": [],
        "subject": "",
        "body": "",
        "bodyHTML": "",
        "attachments": [
          {
            "content": "",
            "type": "",
            "filename": ""
          }
        ]
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
