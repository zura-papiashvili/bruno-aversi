meta {
  name: Send SMS Notification
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/notification/sms
  body: json
  auth: apikey
}

headers {
  x-private-api-key: {{apiKey}}
}

auth:apikey {
  key: x-private-api-key
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "to": "",
    "body": ""
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api/v1/notification/sms
    method: POST
    mode: json
    headers: {
      x-private-api-key: {{apiKey}}
    }
  
    body:json: {
      {
        "to": "",
        "body": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Private API key
  
  request: {
    url: {{baseUrl}}/api/v1/notification/sms
    method: POST
    mode: json
    headers: {
      x-private-api-key: {{apiKey}}
    }
  
    body:json: {
      {
        "to": "",
        "body": ""
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
