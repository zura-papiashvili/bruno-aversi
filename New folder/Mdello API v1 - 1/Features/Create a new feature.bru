meta {
  name: Create a new feature
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_admin/v1/features
  body: json
  auth: inherit
}

body:json {
  {
    "code": "",
    "displayName": "",
    "internalName": "",
    "status": "",
    "type": "",
    "sortOrder": 0,
    "isRequired": false,
    "featureGroupId": 0,
    "categoryIds": []
  }
}

example {
  name: 201 Response
  description: Feature has been successfully created.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/features
    method: POST
    mode: json
    body:json: {
      {
        "code": "",
        "displayName": "",
        "internalName": "",
        "status": "",
        "type": "",
        "sortOrder": 0,
        "isRequired": false,
        "featureGroupId": 0,
        "categoryIds": []
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "code": "",
          "displayName": "",
          "internalName": "",
          "status": "",
          "type": "",
          "sortOrder": 0,
          "createdAt": "",
          "updatedAt": "",
          "deletedAt": "",
          "featureGroup": {},
          "featureValues": [
            {}
          ],
          "categories": [
            {}
          ]
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Feature group or category not found.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/features
    method: POST
    mode: json
    body:json: {
      {
        "code": "",
        "displayName": "",
        "internalName": "",
        "status": "",
        "type": "",
        "sortOrder": 0,
        "isRequired": false,
        "featureGroupId": 0,
        "categoryIds": []
      }
    }
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 409 Response
  description: Feature with this code already exists.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/features
    method: POST
    mode: json
    body:json: {
      {
        "code": "",
        "displayName": "",
        "internalName": "",
        "status": "",
        "type": "",
        "sortOrder": 0,
        "isRequired": false,
        "featureGroupId": 0,
        "categoryIds": []
      }
    }
  }
  
  response: {
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
