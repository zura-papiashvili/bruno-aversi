meta {
  name: Create Request Action
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_admin/v1/request-action
  body: none
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_admin/v1/request-action
    method: POST
    mode: none
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "project": "",
          "user": "",
          "category": "",
          "description": "",
          "metadata": {
            "project": "",
            "apartmentNumber": "",
            "photos": []
          },
          "data": ""
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_admin/v1/request-action
    method: POST
    mode: none
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
