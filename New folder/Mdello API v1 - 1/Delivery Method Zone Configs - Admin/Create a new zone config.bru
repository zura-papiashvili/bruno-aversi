meta {
  name: Create a new zone config
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_admin/v1/delivery-method-zone-configs
  body: json
  auth: inherit
}

body:json {
  {
    "deliveryMethodId": 0,
    "zoneId": 0,
    "dayOptionCode": "",
    "pharmacyMode": "",
    "isEnabled": false,
    "scheduleOverride": {},
    "cutoffTimeOverride": "",
    "timeSlotDurationMinutes": 0,
    "autoSendERP": false,
    "glovoEnabled": false,
    "priority": 0
  }
}

