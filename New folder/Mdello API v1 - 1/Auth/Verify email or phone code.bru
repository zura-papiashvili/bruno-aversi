meta {
  name: Verify email or phone code
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api_public/v1/auth/verify-code
  body: json
  auth: apikey
}

headers {
  x-api-key: {{apiKey}}
}

auth:apikey {
  key: x-api-key
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "emailOrPhone": "",
    "code": "",
    "type": ""
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_public/v1/auth/verify-code
    method: POST
    mode: json
    headers: {
      x-api-key: {{apiKey}}
    }
  
    body:json: {
      {
        "emailOrPhone": "",
        "code": "",
        "type": ""
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_public/v1/auth/verify-code
    method: POST
    mode: json
    headers: {
      x-api-key: {{apiKey}}
    }
  
    body:json: {
      {
        "emailOrPhone": "",
        "code": "",
        "type": ""
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
