meta {
  name: Signup new user
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api_public/v1/auth/signup
  body: json
  auth: apikey
}

headers {
  x-api-key: {{apiKey}}
}

auth:apikey {
  key: x-api-key
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "fullName": "",
    "firstName": "",
    "lastName": "",
    "username": "",
    "idNumber": "",
    "phone": "",
    "email": "",
    "password": "",
    "metadata": {},
    "language": "",
    "imageUrl": ""
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_public/v1/auth/signup
    method: POST
    mode: json
    headers: {
      x-api-key: {{apiKey}}
    }
  
    body:json: {
      {
        "fullName": "",
        "firstName": "",
        "lastName": "",
        "username": "",
        "idNumber": "",
        "phone": "",
        "email": "",
        "password": "",
        "metadata": {},
        "language": "",
        "imageUrl": ""
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_public/v1/auth/signup
    method: POST
    mode: json
    headers: {
      x-api-key: {{apiKey}}
    }
  
    body:json: {
      {
        "fullName": "",
        "firstName": "",
        "lastName": "",
        "username": "",
        "idNumber": "",
        "phone": "",
        "email": "",
        "password": "",
        "metadata": {},
        "language": "",
        "imageUrl": ""
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
