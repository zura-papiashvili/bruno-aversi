meta {
  name: Create a new order without authentication
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_public/v1/orders/checkout
  body: json
  auth: inherit
}

body:json {
  {
    "fullName": "",
    "phone": "",
    "deliveryAddress": "",
