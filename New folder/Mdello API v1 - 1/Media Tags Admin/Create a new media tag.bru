meta {
  name: Create a new media tag
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_admin/v1/media-tags
  body: json
  auth: inherit
}

body:json {
  {
    "name": "",
    "description": "",
    "type": "",
    "url": "",
    "altText": "",
    "location": "",
    "priority": 0,
    "status": "",
    "hexColor": "",
    "width": 0,
    "height": 0,
    "metadata": {}
  }
}

example {
  name: 201 Response
  description: Media tag created successfully
  
  request: {
    url: {{baseUrl}}/api_admin/v1/media-tags
    method: POST
    mode: json
    body:json: {
      {
        "name": "",
        "description": "",
        "type": "",
        "url": "",
        "altText": "",
        "location": "",
        "priority": 0,
        "status": "",
        "hexColor": "",
        "width": 0,
        "height": 0,
        "metadata": {}
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "name": "",
          "description": "",
          "type": "",
          "url": "",
          "altText": "",
          "location": "",
          "priority": 0,
          "status": "",
          "hexColor": "",
          "width": 0,
          "height": 0,
          "metadata": {},
          "createdAt": "",
          "updatedAt": "",
          "deletedAt": ""
        }
      '''
    }
  }
}

