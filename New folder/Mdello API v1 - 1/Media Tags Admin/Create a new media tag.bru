example {
  name: 409 Response
  description: Media tag with this name already exists
  
  request: {
    url: {{baseUrl}}/api_admin/v1/media-tags
    method: POST
    mode: json
    body:json: {
      {
        "name": "",
        "description": "",
        "type": "",
        "url": "",
        "altText": "",
        "location": "",
        "priority": 0,
        "status": "",
        "hexColor": "",
        "width": 0,
