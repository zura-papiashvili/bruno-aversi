      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "imported": 0,
          "updated": 0,
          "errors": [
            {
              "row": 0,
              "error": "",
              "data": {}
            }
          ]
        }
      '''
    }
  }
}

