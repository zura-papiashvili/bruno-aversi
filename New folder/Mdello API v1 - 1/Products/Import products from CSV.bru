example {
  name: 200 Response
  description: CSV import result with statistics
  
  request: {
    url: {{baseUrl}}/api_admin/v1/products/import/csv
    method: POST
    mode: json
    body:json: {
      {
        "csvData": "",
        "mode": ""
      }
    }
  }
  
  response: {
    headers: {
