meta {
  name: Reorder products for a user (drag-and-drop)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api_admin/v1/products/reorder
  body: json
  auth: inherit
}

body:json {
  {
    "orderedIds": [],
    "sortBy": ""
  }
}

example {
  name: 200 Response
  description: Products reordered successfully
  
  request: {
    url: {{baseUrl}}/api_admin/v1/products/reorder
    method: POST
    mode: json
    body:json: {
      {
        "orderedIds": [],
        "sortBy": ""
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

