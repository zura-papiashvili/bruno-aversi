meta {
  name: Get all brands
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api_admin/v1/brands
  body: none
  auth: inherit
}

params:query {
  ~limit: 
  ~page: 
  ~sortBy: 
  ~sortOrder: 
  ~search: 
  ~name: 
  ~ids: 
  ~promoted: 
}

example {
  name: 200 Response
  description: Return all brands.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/brands
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
      ~name: 
      ~ids: 
      ~promoted: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "id": 0,
            "name": "",
            "description": "",
            "color": "",
            "logoUrl": "",
            "erpId": 0,
            "sortOrder": 0,
            "promoted": false,
            "selectedProducts": [],
            "createdAt": "",
            "updatedAt": "",
            "deletedAt": ""
          }
        ]
      '''
    }
  }
}
