meta {
  name: Send Email Notification. Needs to be enabled per project
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api_private/v1/notification/email
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "from": "",
    "fromName": "",
    "to": "",
    "cc": [],
    "subject": "",
    "body": "",
    "bodyHTML": "",
    "attachments": [
      {
        "content": "",
        "type": "",
        "filename": ""
      }
    ]
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/notification/email
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "from": "",
        "fromName": "",
        "to": "",
        "cc": [],
        "subject": "",
        "body": "",
        "bodyHTML": "",
        "attachments": [
          {
            "content": "",
            "type": "",
            "filename": ""
          }
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/notification/email
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "from": "",
        "fromName": "",
        "to": "",
        "cc": [],
        "subject": "",
        "body": "",
        "bodyHTML": "",
        "attachments": [
          {
            "content": "",
            "type": "",
            "filename": ""
          }
        ]
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 403 Response
  description: Outgoing Notifications are not enabled for this project
  
  request: {
    url: {{baseUrl}}/api_private/v1/notification/email
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "from": "",
        "fromName": "",
        "to": "",
        "cc": [],
        "subject": "",
        "body": "",
        "bodyHTML": "",
        "attachments": [
          {
            "content": "",
            "type": "",
            "filename": ""
          }
        ]
      }
    }
  }
  
  response: {
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
