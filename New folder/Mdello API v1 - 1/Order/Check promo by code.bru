meta {
  name: Check promo by code
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api_private/v1/ecommerce/promo-code/:code
  body: none
  auth: apikey
}

params:path {
  code: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/ecommerce/promo-code/:code
    method: GET
    mode: none
    params:path: {
      code: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": {
            "_id": "",
            "projectId": "",
            "customerId": "",
            "sellerIds": [],
            "usesPerUser": 0,
            "percent": 0,
            "amount": 0,
            "type": "",
            "code": "",
            "isArchived": false
          }
        }
      '''
    }
  }
}

