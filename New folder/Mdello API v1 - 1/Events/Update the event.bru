meta {
  name: Update the event
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api_private/v1/event/:id
  body: json
  auth: apikey
}

params:path {
  id: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {}
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/event/:id
    method: PUT
    mode: json
    params:path: {
      id: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "project": "",
          "user": ""
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/event/:id
    method: PUT
    mode: json
    params:path: {
      id: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
