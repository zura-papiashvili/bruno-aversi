meta {
  name: Set main image for a pharmacy
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/api_admin/v1/pharmacies/:id/images/:imageId/main
  body: none
  auth: inherit
}

params:path {
  id: 
  imageId: 
}

example {
  name: 200 Response
  description: Main image set for pharmacy.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/pharmacies/:id/images/:imageId/main
    method: PUT
    mode: none
    params:path: {
      id: 
      imageId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "pharmacy": "",
          "cmsImage": {
            "id": 0,
            "externalProjectId": "",
            "externalUserId": "",
            "originalFileName": "",
            "extension": "",
            "fileName": "",
            "mimetype": "",
            "size": 0,
            "width": 0,
            "height": 0,
            "url": "",
            "externalId": "",
            "createdAt": "",
            "updatedAt": ""
          },
          "isMain": false,
          "sortOrder": 0
        }
      '''
    }
  }
}
