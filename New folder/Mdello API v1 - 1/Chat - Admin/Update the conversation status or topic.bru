meta {
  name: Update the conversation status or topic
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api_admin/v1/conversations/:id
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {}
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_admin/v1/conversations/:id
    method: PUT
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_admin/v1/conversations/:id
    method: PUT
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
