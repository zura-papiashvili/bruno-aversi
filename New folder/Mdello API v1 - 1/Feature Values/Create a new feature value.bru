meta {
  name: Create a new feature value
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_admin/v1/feature-values
  body: json
  auth: inherit
}

body:json {
  {
    "value": "",
    "code": "",
    "featureId": 0,
    "sortOrder": 0
  }
}

example {
  name: 201 Response
  description: Feature value has been successfully created.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/feature-values
    method: POST
    mode: json
    body:json: {
      {
        "value": "",
        "code": "",
        "featureId": 0,
        "sortOrder": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "value": "",
          "code": "",
          "sortOrder": 0,
          "createdAt": "",
          "updatedAt": "",
          "deletedAt": "",
          "feature": {},
          "productFeatureValues": [
            {}
          ]
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Feature not found.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/feature-values
    method: POST
    mode: json
    body:json: {
      {
        "value": "",
        "code": "",
        "featureId": 0,
        "sortOrder": 0
      }
    }
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 409 Response
  description: Feature value with this code already exists.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/feature-values
    method: POST
    mode: json
    body:json: {
      {
        "value": "",
        "code": "",
        "featureId": 0,
        "sortOrder": 0
      }
    }
  }
  
  response: {
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
