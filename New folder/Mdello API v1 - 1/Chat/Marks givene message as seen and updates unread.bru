meta {
  name: Marks givene message as seen and updates unread
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api_private/v1/conversations/:id/messages/:messageId/seen
  body: none
  auth: apikey
}

params:path {
  messageId: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/conversations/:id/messages/:messageId/seen
    method: PUT
    mode: none
    params:path: {
      messageId: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/conversations/:id/messages/:messageId/seen
    method: PUT
    mode: none
    params:path: {
      messageId: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
