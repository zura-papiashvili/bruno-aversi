meta {
  name: Create a new zone
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_admin/v1/zones
  body: json
  auth: inherit
}

body:json {
  {
    "name": "",
    "is_active": false,
    "is_default": false,
    "hub_pharmacy_id": 0,
    "delivery_pharmacies_ids": [],
    "pickup_pharmacies_ids": [],
    "priority": 0,
    "region_id": 0
  }
}

example {
  name: 201 Response
  description: The zone has been successfully created.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/zones
    method: POST
    mode: json
    body:json: {
      {
        "name": "",
        "is_active": false,
        "is_default": false,
        "hub_pharmacy_id": 0,
        "delivery_pharmacies_ids": [],
        "pickup_pharmacies_ids": [],
        "priority": 0,
        "region_id": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "name": "",
          "is_active": false,
          "is_default": false,
          "hub_pharmacy_id": 0,
          "priority": 0,
          "createdAt": "",
          "updatedAt": "",
          "deletedAt": "",
          "region": ""
        }
      '''
    }
  }
}
