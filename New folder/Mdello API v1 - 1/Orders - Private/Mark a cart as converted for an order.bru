meta {
  name: Mark a cart as converted for an order
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api_private/v1/orders/cart/convert
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "cartId": 0,
    "orderId": 0
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/orders/cart/convert
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "cartId": 0,
        "orderId": 0
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/orders/cart/convert
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "cartId": 0,
        "orderId": 0
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
