meta {
  name: Get Flitt embedded checkout token with SDK options for frontend integration
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api_private/v1/payment/flitt/embedded-checkout
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "tbcPaymentMethods": [],
    "loanConfig": {},
    "successURL": "",
    "errorURL": "",
    "merchantId": "",
    "isTestTransaction": false,
    "paymentMethodId": 0,
    "designId": "",
    "flittPaymentMethods": [],
    "flittDisabledMethods": [],
    "flittWalletMethods": []
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/payment/flitt/embedded-checkout
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "tbcPaymentMethods": [],
        "loanConfig": {},
        "successURL": "",
        "errorURL": "",
        "merchantId": "",
        "isTestTransaction": false,
        "paymentMethodId": 0,
        "designId": "",
        "flittPaymentMethods": [],
        "flittDisabledMethods": [],
        "flittWalletMethods": []
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/payment/flitt/embedded-checkout
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "tbcPaymentMethods": [],
        "loanConfig": {},
        "successURL": "",
        "errorURL": "",
        "merchantId": "",
        "isTestTransaction": false,
        "paymentMethodId": 0,
        "designId": "",
        "flittPaymentMethods": [],
        "flittDisabledMethods": [],
        "flittWalletMethods": []
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
