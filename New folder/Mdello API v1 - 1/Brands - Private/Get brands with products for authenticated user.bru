meta {
  name: Get brands with products for authenticated user
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api_private/v1/brands/with-products
  body: none
  auth: apikey
}

params:query {
  ~limit: 
  ~page: 
  ~sortBy: 
  ~sortOrder: 
  ~search: 
  ~name: 
  ~ids: 
  ~promoted: 
  ~productsLimit: 
  ~lang: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  description: Paginated list of brands with products.
  
  request: {
    url: {{baseUrl}}/api_private/v1/brands/with-products
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
      ~name: 
      ~ids: 
      ~promoted: 
      ~productsLimit: 
      ~lang: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/brands/with-products
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
      ~name: 
      ~ids: 
      ~promoted: 
      ~productsLimit: 
      ~lang: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
