meta {
  name: Create a new box
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api_private/v1/box
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "type": "",
    "key": "",
    "data": {},
    "metadata": {},
    "isAvailableAnonymously": false
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/box
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "type": "",
        "key": "",
        "data": {},
        "metadata": {},
        "isAvailableAnonymously": false
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "_id": "",
          "project": "",
          "user": "",
          "type": "",
          "key": "",
          "data": {},
          "metadata": {},
          "accessKey": ""
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/box
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "type": "",
        "key": "",
        "data": {},
        "metadata": {},
        "isAvailableAnonymously": false
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
