            "latitude": 0,
            "schedule": {},
            "delivery_zones": [
              {
                "id": 0,
                "name": "",
                "region": {
                  "id": 0,
                  "name": ""
                }
              }
            ],
            "pickup_zones": [
              {}
            ],
            "distanceMeters": 0
          },
          "product": {
            "id": 0,
            "name": "",
            "code": ""
          },
          "stock": 0,
          "createdAt": "",
          "updatedAt": "",
          "deletedAt": ""
        }
      '''
    }
  }
}
