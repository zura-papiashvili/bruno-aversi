meta {
  name: Get stock by pharmacy and product
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api_admin/v1/pharmacy-stock/pharmacy/:pharmacyId/product/:productId
  body: none
  auth: inherit
}

params:path {
  pharmacyId: 
  productId: 
}

example {
  name: 200 Response
  description: Stock entry for specific pharmacy and product.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/pharmacy-stock/pharmacy/:pharmacyId/product/:productId
    method: GET
    mode: none
    params:path: {
      pharmacyId: 
      productId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "pharmacy": {
            "id": 0,
            "name": "",
            "nameGE": "",
            "old_name": "",
            "is_pickup": false,
            "is_delivery": false,
            "address": "",
