meta {
  name: Confirm the change by user
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api_private/v1/request-action/:id/review
  body: json
  auth: apikey
}

params:path {
  id: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "status": ""
  }
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/request-action/:id/review
    method: PUT
    mode: json
    params:path: {
      id: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "status": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "project": "",
          "user": "",
          "category": "",
          "description": "",
          "metadata": {
            "project": "",
            "apartmentNumber": "",
            "photos": []
          },
          "data": ""
        }
      '''
    }
  }
}

