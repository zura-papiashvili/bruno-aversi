meta {
  name: Get single action by id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api_private/v1/request-action/:id
  body: none
  auth: apikey
}

params:path {
  id: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/request-action/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "project": "",
          "user": "",
          "category": "",
          "description": "",
          "metadata": {
            "project": "",
            "apartmentNumber": "",
            "photos": []
          },
          "data": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Action not found or can't be deleted
  
  request: {
    url: {{baseUrl}}/api_private/v1/request-action/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/request-action/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
