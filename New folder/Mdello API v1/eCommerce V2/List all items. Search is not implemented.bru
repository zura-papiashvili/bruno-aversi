meta {
  name: List all items. Search is not implemented
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api_private/v2/ecommerce/item
  body: none
  auth: apikey
}

params:query {
  ~limit: 
  ~page: 
  ~sortBy: 
  ~sortOrder: 
  ~search: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_private/v2/ecommerce/item
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "_id": "",
            "name": "",
            "type": "",
            "price": 0,
            "currency": "",
            "countryCode": "",
            "seller": {
              "_id": "",
              "name": "",
              "uniqueCode": "",
              "en": {
                "name": "",
                "address": "",
                "thumbnail": "",
                "phone": ""
              },
              "ka": {}
            },
            "en": {
              "name": "",
              "thumbnail": ""
            },
            "ka": {}
          }
        ]
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v2/ecommerce/item
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
