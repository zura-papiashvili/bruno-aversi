meta {
  name: Get current sync settings
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api_admin/v1/sync-settings
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: The current sync settings
  
  request: {
    url: {{baseUrl}}/api_admin/v1/sync-settings
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "syncProducts": false,
          "syncCategories": false,
          "syncPharmacies": false,
          "syncZones": false,
          "syncRegions": false,
          "createdAt": "",
          "updatedAt": "",
          "deletedAt": ""
        }
      '''
    }
  }
}
