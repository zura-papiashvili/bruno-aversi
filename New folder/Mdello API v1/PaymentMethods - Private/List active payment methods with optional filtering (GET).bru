meta {
  name: List active payment methods with optional filtering (GET)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api_private/v1/payment-methods
  body: none
  auth: apikey
}

params:query {
  ~orderAmount: 
  ~productIds: 
  ~customerGroupId: 
  ~zoneId: 
  ~deliveryMethodId: 
  ~countryCode: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/payment-methods
    method: GET
    mode: none
    params:query: {
      ~orderAmount: 
      ~productIds: 
      ~customerGroupId: 
      ~zoneId: 
      ~deliveryMethodId: 
      ~countryCode: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/payment-methods
    method: GET
    mode: none
    params:query: {
      ~orderAmount: 
      ~productIds: 
      ~customerGroupId: 
      ~zoneId: 
      ~deliveryMethodId: 
      ~countryCode: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
