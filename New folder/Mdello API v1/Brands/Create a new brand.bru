meta {
  name: Create a new brand
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_admin/v1/brands
  body: json
  auth: inherit
}

body:json {
  {
    "name": "",
    "description": "",
    "color": "",
    "logoUrl": "",
    "selectedProductIds": [],
    "promoted": false
  }
}

example {
  name: 201 Response
  description: The brand has been successfully created.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/brands
    method: POST
    mode: json
    body:json: {
      {
        "name": "",
        "description": "",
        "color": "",
        "logoUrl": "",
        "selectedProductIds": [],
        "promoted": false
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "name": "",
          "description": "",
          "color": "",
          "logoUrl": "",
          "erpId": 0,
          "sortOrder": 0,
          "promoted": false,
          "selectedProducts": [],
          "createdAt": "",
          "updatedAt": "",
          "deletedAt": ""
        }
      '''
    }
  }
}
