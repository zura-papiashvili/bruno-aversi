meta {
  name: Get order statuses visible to customers
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api_public/v1/order-statuses
  body: none
  auth: apikey
}

headers {
  x-api-key: {{apiKey}}
}

auth:apikey {
  key: x-api-key
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  description: List of visible order statuses.
  
  request: {
    url: {{baseUrl}}/api_public/v1/order-statuses
    method: GET
    mode: none
    headers: {
      x-api-key: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
