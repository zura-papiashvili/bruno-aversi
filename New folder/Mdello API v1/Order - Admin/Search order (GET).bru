      ~sortBy: 
      ~sortOrder: 
      ~search: 
      ~statusIn: 
      ~typeIn: 
      ~withTickets: 
      ~sellerUserId: 
      ~customerUserId: 
      ~itemId: 
    }
  
    params:path: {
      projectId: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
