meta {
  name: Search order (GET)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api_admin/v1/project/:projectId/ecommerce/order/search
  body: none
  auth: apikey
}

params:query {
  ~limit: 
  ~page: 
  ~sortBy: 
  ~sortOrder: 
  ~search: 
  ~statusIn: 
  ~typeIn: 
  ~withTickets: 
  ~sellerUserId: 
  ~customerUserId: 
  ~itemId: 
}

params:path {
  projectId: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_admin/v1/project/:projectId/ecommerce/order/search
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
      ~statusIn: 
      ~typeIn: 
      ~withTickets: 
      ~sellerUserId: 
      ~customerUserId: 
      ~itemId: 
    }
  
    params:path: {
      projectId: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "data": [],
          "paging": {
            "total": 0,
            "limit": 0,
            "page": 0,
            "sortBy": "",
            "sortOrder": 0,
            "search": ""
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_admin/v1/project/:projectId/ecommerce/order/search
    method: GET
    mode: none
