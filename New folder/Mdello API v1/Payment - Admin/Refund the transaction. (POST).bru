meta {
  name: Refund the transaction. (POST)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api_admin/v1/payment/transaction/:id/refund
  body: none
  auth: apikey
}

params:path {
  id: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_admin/v1/payment/transaction/:id/refund
    method: POST
    mode: none
    params:path: {
      id: 
