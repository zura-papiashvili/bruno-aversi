meta {
  name: Get transaction history
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api_private/v1/payment/transaction/history
  body: none
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/payment/transaction/history
    method: GET
    mode: none
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "transactions": [
            {
              "provider": "",
              "id": 0,
              "externalProjectId": "",
              "externalUserId": "",
              "orderId": 0,
              "source": "",
              "externalTransactionId": "",
              "transactionId": "",
              "bankCard": {
                "provider": "",
                "id": 0,
                "externalProjectId": "",
                "externalUserId": "",
                "status": "",
                "mask": "",
                "name": "",
                "isDefault": false,
                "externalCardId": "",
                "externalTransactionId": "",
                "transactionId": "",
                "externalTransactionUrl": "",
                "merchantId": "",
                "createdAt": "",
                "updatedAt": ""
              },
              "status": "",
              "merchantStatus": "",
              "blockedAmount": 0,
              "amount": 0,
              "fee": 0,
              "feeDiscount": 0,
              "splitCommission": 0,
              "finalAmount": 0,
              "refundAmount": 0,
              "currency": "",
              "purchaseUnits": {},
              "splitPreferrence": [
                {
                  "amount": 0,
                  "percent": 0,
                  "iban": "",
                  "description": ""
                }
              ],
              "config": {},
              "isSuccessExecuted": false,
              "merchantId": "",
              "createdAt": "",
              "updatedAt": ""
            }
          ],
          "success": false
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/payment/transaction/history
    method: GET
    mode: none
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
