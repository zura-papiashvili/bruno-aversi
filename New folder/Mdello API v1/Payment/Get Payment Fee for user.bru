meta {
  name: Get Payment Fee for user
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api_private/v1/payment/fee
  body: none
  auth: apikey
}

params:query {
  provider: 
  ~bankCardId: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/payment/fee
    method: GET
    mode: none
    params:query: {
      ~bankCardId: 
      provider: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/payment/fee
    method: GET
    mode: none
    params:query: {
      ~bankCardId: 
      provider: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
