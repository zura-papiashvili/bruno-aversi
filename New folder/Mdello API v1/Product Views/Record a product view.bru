meta {
  name: Record a product view
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_public/v1/products/:id/view
  body: json
  auth: inherit
}

params:path {
  id: 
}

body:json {
  {
    "viewerId": "",
    "ipAddress": ""
  }
}

example {
  name: 201 Response
  description: Product view recorded successfully
  
  request: {
    url: {{baseUrl}}/api_public/v1/products/:id/view
    method: POST
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {
        "viewerId": "",
        "ipAddress": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "product": {
            "id": 0,
            "name": ""
          },
          "viewerId": "",
          "ipAddress": "",
          "viewedAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 204 Response
  description: View already recorded within the last hour
  
  request: {
    url: {{baseUrl}}/api_public/v1/products/:id/view
    method: POST
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {
        "viewerId": "",
        "ipAddress": ""
      }
    }
  }
  
  response: {
    status: {
      code: 204
      text: No Content
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
