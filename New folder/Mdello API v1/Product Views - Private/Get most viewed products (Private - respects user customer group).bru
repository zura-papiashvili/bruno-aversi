meta {
  name: Get most viewed products (Private - respects user customer group)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api_private/v1/products/most-viewed
  body: none
  auth: inherit
}

params:query {
  ~limit: 
  ~page: 
  ~sortBy: 
  ~sortOrder: 
  ~search: 
  ~days: 
  ~brandIds: 
  ~categoryIds: 
  ~featureValueIds: 
  ~minPrice: 
  ~maxPrice: 
  ~discountRanges: 
}

example {
  name: 200 Response
  description: Most viewed products
  
  request: {
    url: {{baseUrl}}/api_private/v1/products/most-viewed
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
      ~days: 
      ~brandIds: 
      ~categoryIds: 
      ~featureValueIds: 
      ~minPrice: 
      ~maxPrice: 
      ~discountRanges: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "product": {},
            "totalViews": 0,
            "uniqueViewers": 0,
            "currentlyViewing": 0,
            "lastViewedAt": "",
            "productId": 0,
            "productName": "",
            "productImgUrl": "",
            "price": 0,
            "listPrice": 0,
            "offerInfo": {}
          }
        ]
      '''
    }
  }
}
