meta {
  name: Create or get existing checkout session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/checkout-sessions
  body: json
  auth: inherit
}

body:json {
  {
    "userId": "",
    "guestSessionId": "",
    "abandonedCartId": 0,
    "checkoutData": {}
  }
}

