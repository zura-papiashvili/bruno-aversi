meta {
  name: Unlink a product from its related group
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api_admin/v1/products/unlink-related
  body: json
  auth: inherit
}

body:json {
  {
    "productId": 0
  }
}

example {
  name: 200 Response
  description: Product unlinked successfully from related group
  
  request: {
    url: {{baseUrl}}/api_admin/v1/products/unlink-related
    method: DELETE
    mode: json
    body:json: {
      {
        "productId": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "relatedGroupId": 0,
          "groupProductIds": []
        }
      '''
    }
  }
}

