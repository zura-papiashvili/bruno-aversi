meta {
  name: Generate token to share the ticket anonymously
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api_private/v1/ticket/:id/share
  body: none
  auth: apikey
}

params:path {
  id: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/ticket/:id/share
    method: POST
    mode: none
    params:path: {
      id: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "data": {
            "_id": "",
            "projectId": "",
            "merchantId": ""
          }
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Invalid token
  
  request: {
    url: {{baseUrl}}/api_private/v1/ticket/:id/share
    method: POST
    mode: none
    params:path: {
      id: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/ticket/:id/share
    method: POST
    mode: none
    params:path: {
      id: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
