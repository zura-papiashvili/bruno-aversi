meta {
  name: Get order by id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api_private/v1/ecommerce/order/:orderId
  body: none
  auth: apikey
}

params:path {
  orderId: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/ecommerce/order/:orderId
    method: GET
    mode: none
    params:path: {
      orderId: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "data": {
            "_id": "",
            "project": "",
            "sellerId": "",
            "customerId": "",
            "groupId": "",
            "createdAt": ""
          }
        }
      '''
    }
  }
}

