meta {
  name: Upload Profile Image
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api_private/v1/auth/profile/image
  body: multipartForm
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:multipart-form {
  file: 
}

example {
  name: 200 Response
  description: Profile image uploaded successfully
  
  request: {
    url: {{baseUrl}}/api_private/v1/auth/profile/image
