meta {
  name: Invite new User
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api_private/v1/auth/invite
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "user": {
      "birthDate": "",
      "fullName": "",
      "email": "",
      "phone": "",
      "idNumber": ""
    },
    "apartment": "",
    "permissionSet": "",
    "inviteChannel": ""
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/auth/invite
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "user": {
          "birthDate": "",
          "fullName": "",
          "email": "",
          "phone": "",
          "idNumber": ""
        },
        "apartment": "",
        "permissionSet": "",
        "inviteChannel": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "data": {
            "text": ""
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/auth/invite
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "user": {
          "birthDate": "",
          "fullName": "",
          "email": "",
          "phone": "",
          "idNumber": ""
        },
        "apartment": "",
        "permissionSet": "",
        "inviteChannel": ""
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
