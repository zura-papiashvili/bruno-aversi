meta {
  name: Create a new order for the current user (checkout alias)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api_private/v1/orders/checkout
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "customerFullName": "",
    "customerPhone": "",
    "address": "",
    "customerComment": "",
    "deliveryTime": "",
    "pharmacyId": 0,
    "deliveryPrice": 0,
    "deliveryGroupCount": 0,
    "paymentMethodId": 0,
    "deliveryMethodId": 0,
    "orderItems": [
      {
        "productId": 0,
        "quantity": 0
      }
    ],
    "latitude": 0,
    "longitude": 0,
    "customerZoneId": 0,
    "customerRegionId": 0,
    "promoCode": "",
    "declinedGiftProductIds": [],
    "expectedTotalAmount": 0,
    "deliveryAddress": ""
  }
}

example {
  name: 201 Response
  description: Order created successfully.
  
  request: {
    url: {{baseUrl}}/api_private/v1/orders/checkout
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "customerFullName": "",
        "customerPhone": "",
        "address": "",
        "customerComment": "",
        "deliveryTime": "",
        "pharmacyId": 0,
        "deliveryPrice": 0,
        "deliveryGroupCount": 0,
        "paymentMethodId": 0,
        "deliveryMethodId": 0,
        "orderItems": [
          {
            "productId": 0,
            "quantity": 0
          }
        ],
        "latitude": 0,
        "longitude": 0,
        "customerZoneId": 0,
        "customerRegionId": 0,
        "promoCode": "",
        "declinedGiftProductIds": [],
        "expectedTotalAmount": 0,
        "deliveryAddress": ""
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

