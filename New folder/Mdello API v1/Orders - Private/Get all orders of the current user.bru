meta {
  name: Get all orders of the current user
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api_private/v1/orders
  body: none
  auth: apikey
}

params:query {
  ~limit: 
  ~page: 
  ~sortBy: 
  ~sortOrder: 
  ~search: 
  ~customerId: 
  ~pharmacyId: 
  ~statusId: 
  ~paymentMethodId: 
  ~deliveryMethodId: 
  ~includeDrafts: 
  ~minTotalAmount: 
  ~maxTotalAmount: 
  ~createdFromDate: 
  ~createdToDate: 
  ~externalProjectId: 
  ~orderNumber: 
  ~customerName: 
  ~customerPhone: 
  ~customerEmail: 
  ~additionalStatusId: 
  ~managerId: 
  ~easyOfferId: 
  ~customerZoneId: 
  ~productId: 
  ~productName: 
  ~categoryId: 
  ~productCode: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  description: List of orders filtered to the authenticated user.
  
  request: {
    url: {{baseUrl}}/api_private/v1/orders
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
      ~customerId: 
      ~pharmacyId: 
      ~statusId: 
      ~paymentMethodId: 
      ~deliveryMethodId: 
      ~includeDrafts: 
      ~minTotalAmount: 
      ~maxTotalAmount: 
      ~createdFromDate: 
      ~createdToDate: 
      ~externalProjectId: 
      ~orderNumber: 
      ~customerName: 
      ~customerPhone: 
      ~customerEmail: 
      ~additionalStatusId: 
      ~managerId: 
      ~easyOfferId: 
      ~customerZoneId: 
      ~productId: 
      ~productName: 
      ~categoryId: 
      ~productCode: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/orders
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
      ~customerId: 
      ~pharmacyId: 
      ~statusId: 
      ~paymentMethodId: 
      ~deliveryMethodId: 
      ~includeDrafts: 
      ~minTotalAmount: 
      ~maxTotalAmount: 
      ~createdFromDate: 
      ~createdToDate: 
      ~externalProjectId: 
      ~orderNumber: 
      ~customerName: 
      ~customerPhone: 
      ~customerEmail: 
      ~additionalStatusId: 
      ~managerId: 
      ~easyOfferId: 
      ~customerZoneId: 
      ~productId: 
      ~productName: 
      ~categoryId: 
      ~productCode: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
