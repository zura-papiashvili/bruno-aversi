meta {
  name: Create new Notification for project
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_admin/v1/notification
  body: json
  auth: apikey
}

params:query {
  projectId: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {}
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_admin/v1/notification
    method: POST
    mode: json
    params:query: {
      projectId: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false
        }
      '''
    }
  }
}

