meta {
  name: Get all easy offers for authenticated user (with query & paging)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api_private/v1/easy-offers
  body: none
  auth: apikey
}

params:query {
  ~limit: 
  ~page: 
  ~sortBy: 
  ~sortOrder: 
  ~search: 
  ~brandIds: 
  ~productIds: 
  ~minSalePercent: 
  ~maxSalePercent: 
  ~saleEndDateFrom: 
  ~saleEndDateTo: 
  ~isOnePlusOneOffer: 
  ~offerSectionKey: 
  ~title: 
  ~offerType: 
  ~status: 
  ~isSpecial: 
  ~isActive: 
  ~isMonthly: 
  ~isHidden: 
  ~isBannerOffer: 
  ~customerGroupIds: 
  ~userId: 
  ~lang: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  description: List of easy offers with paging.
  
  request: {
    url: {{baseUrl}}/api_private/v1/easy-offers
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
      ~brandIds: 
      ~productIds: 
      ~minSalePercent: 
      ~maxSalePercent: 
      ~saleEndDateFrom: 
      ~saleEndDateTo: 
      ~isOnePlusOneOffer: 
      ~offerSectionKey: 
      ~title: 
      ~offerType: 
      ~status: 
      ~isSpecial: 
      ~isActive: 
      ~isMonthly: 
      ~isHidden: 
      ~isBannerOffer: 
      ~customerGroupIds: 
      ~userId: 
      ~lang: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/easy-offers
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
      ~brandIds: 
      ~productIds: 
      ~minSalePercent: 
      ~maxSalePercent: 
      ~saleEndDateFrom: 
      ~saleEndDateTo: 
      ~isOnePlusOneOffer: 
      ~offerSectionKey: 
      ~title: 
      ~offerType: 
      ~status: 
      ~isSpecial: 
      ~isActive: 
      ~isMonthly: 
      ~isHidden: 
      ~isBannerOffer: 
      ~customerGroupIds: 
      ~userId: 
      ~lang: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
