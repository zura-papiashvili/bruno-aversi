meta {
  name: Add a single feature value to a product
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api_admin/v1/product-feature-values/product/:productId/feature-value/:featureValueId
  body: none
  auth: inherit
}

params:path {
  productId: 
  featureValueId: 
}

example {
  name: 201 Response
  description: Feature value has been successfully added to the product.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/product-feature-values/product/:productId/feature-value/:featureValueId
    method: POST
    mode: none
    params:path: {
      productId: 
      featureValueId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "createdAt": "",
          "updatedAt": "",
          "deletedAt": "",
          "product": {},
          "featureValue": {}
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Product or feature value not found.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/product-feature-values/product/:productId/feature-value/:featureValueId
    method: POST
    mode: none
    params:path: {
      productId: 
      featureValueId: 
    }
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 409 Response
  description: Feature value is already assigned to this product.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/product-feature-values/product/:productId/feature-value/:featureValueId
    method: POST
    mode: none
    params:path: {
      productId: 
      featureValueId: 
    }
  }
  
  response: {
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
