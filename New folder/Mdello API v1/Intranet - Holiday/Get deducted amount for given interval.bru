meta {
  name: Get deducted amount for given interval
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api_private/v1/intranet/holiday/check
  body: none
  auth: apikey
}

params:query {
  startDate: 
  endDate: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/intranet/holiday/check
    method: GET
    mode: none
    params:query: {
      startDate: 
      endDate: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {}
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/intranet/holiday/check
    method: GET
    mode: none
    params:query: {
      startDate: 
      endDate: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
