meta {
  name: Update the entity
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api_admin/v1/project/:projectId/entity/:kind/:entityId
  body: none
  auth: apikey
}

params:path {
  projectId: 
  kind: 
  entityId: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_admin/v1/project/:projectId/entity/:kind/:entityId
