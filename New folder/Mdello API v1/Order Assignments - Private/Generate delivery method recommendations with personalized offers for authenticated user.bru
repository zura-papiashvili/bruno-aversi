meta {
  name: Generate delivery method recommendations with personalized offers for authenticated user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_private/v1/order-assignments/recommend
  body: json
  auth: apikey
}

params:query {
  ~lang: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "products": [
      {
