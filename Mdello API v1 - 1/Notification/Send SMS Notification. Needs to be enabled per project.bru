meta {
  name: Send SMS Notification. Needs to be enabled per project
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api_private/v1/notification/sms
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "to": "",
    "body": ""
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/notification/sms
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "to": "",
        "body": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/notification/sms
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "to": "",
        "body": ""
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 403 Response
  description: Outgoing Notifications are not enabled for this project
  
  request: {
    url: {{baseUrl}}/api_private/v1/notification/sms
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "to": "",
        "body": ""
      }
    }
  }
  
  response: {
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
