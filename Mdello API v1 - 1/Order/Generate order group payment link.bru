meta {
  name: Generate order group payment link
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api_private/v1/ecommerce/order-group/pay
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "bankCardId": 0,
    "paymentProvider": "",
    "successURL": "",
    "errorURL": "",
    "purchaseUnits": [
      {
        "type": "",
        "id": "",
        "amount": 0,
        "quantity": 0,
        "discount": 0
      }
    ],
    "loan": {
      "month": 0,
      "type": "",
      "method": ""
    }
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/ecommerce/order-group/pay
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "bankCardId": 0,
        "paymentProvider": "",
        "successURL": "",
        "errorURL": "",
        "purchaseUnits": [
          {
            "type": "",
            "id": "",
            "amount": 0,
            "quantity": 0,
            "discount": 0
          }
        ],
        "loan": {
          "month": 0,
          "type": "",
          "method": ""
        }
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "transactionUrl": ""
        }
      '''
    }
  }
}

