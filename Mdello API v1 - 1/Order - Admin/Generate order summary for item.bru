meta {
  name: Generate order summary for item
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api_admin/v1/project/:projectId/ecommerce/order/csv/:itemId
  body: none
  auth: apikey
}

params:path {
  itemId: 
  projectId: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_admin/v1/project/:projectId/ecommerce/order/csv/:itemId
    method: POST
    mode: none
    params:path: {
      itemId: 
      projectId: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

