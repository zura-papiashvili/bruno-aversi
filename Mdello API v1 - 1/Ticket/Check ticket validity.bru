meta {
  name: Check ticket validity
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_private/v1/ticket/check
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "ticketToken": "",
    "markAsUsed": false
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/ticket/check
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "ticketToken": "",
        "markAsUsed": false
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "data": {
            "_id": "",
            "projectId": "",
            "merchantId": ""
          }
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Invalid token
  
  request: {
    url: {{baseUrl}}/api_private/v1/ticket/check
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "ticketToken": "",
        "markAsUsed": false
      }
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/ticket/check
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "ticketToken": "",
        "markAsUsed": false
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
