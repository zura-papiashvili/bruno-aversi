meta {
  name: Link two products as variations
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_admin/v1/products/link-variations
  body: json
  auth: inherit
}

body:json {
  {
    "productId1": 0,
    "productId2": 0
  }
}

example {
  name: 201 Response
  description: Products linked successfully as variations
  
  request: {
    url: {{baseUrl}}/api_admin/v1/products/link-variations
    method: POST
    mode: json
    body:json: {
      {
        "productId1": 0,
        "productId2": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "variationGroupId": 0,
          "groupProductIds": []
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Bad request - products cannot be linked
  
  request: {
    url: {{baseUrl}}/api_admin/v1/products/link-variations
    method: POST
    mode: json
    body:json: {
      {
        "productId1": 0,
        "productId2": 0
      }
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized
  
  request: {
    url: {{baseUrl}}/api_admin/v1/products/link-variations
    method: POST
    mode: json
    body:json: {
      {
        "productId1": 0,
        "productId2": 0
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 404 Response
  description: One or both products not found
  
  request: {
    url: {{baseUrl}}/api_admin/v1/products/link-variations
    method: POST
    mode: json
    body:json: {
      {
        "productId1": 0,
        "productId2": 0
      }
    }
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
