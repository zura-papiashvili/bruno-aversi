example {
  name: 404 Response
  description: One or more products not found
  
  request: {
    url: {{baseUrl}}/api_admin/v1/products/link-related
    method: POST
    mode: json
    body:json: {
      {
        "productIds": []
      }
    }
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
  
      '''
