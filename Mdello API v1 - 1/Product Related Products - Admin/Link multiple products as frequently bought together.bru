meta {
  name: Link multiple products as frequently bought together
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_admin/v1/products/link-related
  body: json
  auth: inherit
}

body:json {
  {
    "productIds": []
  }
}

example {
  name: 201 Response
  description: Products linked successfully as related products
  
  request: {
    url: {{baseUrl}}/api_admin/v1/products/link-related
    method: POST
    mode: json
    body:json: {
      {
        "productIds": []
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "relatedGroupId": 0,
          "groupProductIds": []
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Bad request - Invalid product IDs or insufficient products
  
  request: {
    url: {{baseUrl}}/api_admin/v1/products/link-related
    method: POST
    mode: json
    body:json: {
      {
        "productIds": []
      }
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

