meta {
  name: Change Current User Password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api_private/v1/auth/change-password
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "currentPassword": "",
    "newPassword": ""
  }
}

example {
  name: 200 Response
  description: Password changed successfully
  
  request: {
    url: {{baseUrl}}/api_private/v1/auth/change-password
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "currentPassword": "",
        "newPassword": ""
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

