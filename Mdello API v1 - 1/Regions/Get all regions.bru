meta {
  name: Get all regions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api_admin/v1/regions
  body: none
  auth: inherit
}

params:query {
  ~limit: 
  ~page: 
  ~sortBy: 
  ~sortOrder: 
  ~search: 
  ~name: 
  ~code: 
  ~country: 
  ~is_active: 
  ~priority: 
}

