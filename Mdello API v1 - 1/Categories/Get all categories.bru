meta {
  name: Get all categories
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api_admin/v1/product-categories
  body: none
  auth: inherit
}

params:query {
  ~limit: 
  ~page: 
  ~sortBy: 
  ~sortOrder: 
  ~search: 
  ~name: 
  ~categoryIds: 
  ~parentId: 
  ~status: 
  ~type: 
  ~isPurchasable: 
