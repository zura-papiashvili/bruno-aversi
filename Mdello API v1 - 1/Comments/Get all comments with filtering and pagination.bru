meta {
  name: Get all comments with filtering and pagination
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api_admin/v1/comments
  body: none
  auth: inherit
}

params:query {
  ~limit: 
  ~page: 
  ~sortBy: 
  ~sortOrder: 
  ~search: 
  ~entityType: 
  ~entityId: 
  ~userId: 
}

example {
  name: 200 Response
  description: List of comments
  
  request: {
    url: {{baseUrl}}/api_admin/v1/comments
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
      ~entityType: 
      ~entityId: 
      ~userId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "id": 0,
            "entityType": "",
            "entityId": 0,
            "userId": "",
            "content": "",
            "createdAt": "",
            "updatedAt": "",
            "deletedAt": ""
          }
        ]
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_admin/v1/comments
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
      ~entityType: 
      ~entityId: 
      ~userId: 
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
