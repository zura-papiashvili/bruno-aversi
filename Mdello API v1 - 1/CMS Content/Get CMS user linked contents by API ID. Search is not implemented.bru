meta {
  name: Get CMS user linked contents by API ID. Search is not implemented
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api_private/v3/cms/content/api/:apiId
  body: none
  auth: apikey
}

params:query {
  ~limit: 
  ~page: 
  ~sortBy: 
  ~sortOrder: 
  ~search: 
}

params:path {
  apiId: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_private/v3/cms/content/api/:apiId
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
    }
  
    params:path: {
      apiId: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v3/cms/content/api/:apiId
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
    }
  
    params:path: {
      apiId: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
