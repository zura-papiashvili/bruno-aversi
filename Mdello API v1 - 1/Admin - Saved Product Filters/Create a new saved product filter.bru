example {
  name: 409 Response
  description: A saved filter with this title already exists
  
  request: {
    url: {{baseUrl}}/api_admin/v1/saved-product-filters
    method: POST
    mode: json
    body:json: {
      {
        "name": "",
        "description": "",
        "filters": {}
      }
    }
  }
  
