meta {
  name: Create a new saved product filter
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_admin/v1/saved-product-filters
  body: json
  auth: inherit
}

body:json {
  {
    "name": "",
    "description": "",
    "filters": {}
  }
}

example {
  name: 201 Response
  description: Saved filter created successfully
  
  request: {
    url: {{baseUrl}}/api_admin/v1/saved-product-filters
    method: POST
    mode: json
    body:json: {
      {
        "name": "",
        "description": "",
        "filters": {}
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
