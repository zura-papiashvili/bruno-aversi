meta {
  name: Create new Order
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api_private/v2/ecommerce/order
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "items": [],
    "payment": {
      "paymentProvider": "",
      "successURL": "",
      "errorURL": "",
      "loan": {
        "month": 0,
        "type": "",
        "method": ""
      }
    },
    "data": {
      "sellerId": "",
      "sellerName": "",
      "bundleId": "",
      "isGuest": false,
      "stationId": "",
      "pickupTime": "",
      "metadata": {}
    }
  }
}

example {
  name: 201 Response
  
