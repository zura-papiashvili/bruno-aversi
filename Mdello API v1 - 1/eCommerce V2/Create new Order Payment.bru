    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "paymentProvider": "",
        "successURL": "",
        "errorURL": "",
        "loan": {
          "month": 0,
          "type": "",
          "method": ""
        }
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
