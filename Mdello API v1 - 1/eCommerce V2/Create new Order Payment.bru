meta {
  name: Create new Order Payment
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api_private/v2/ecommerce/order/:id/payment
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "paymentProvider": "",
    "successURL": "",
    "errorURL": "",
    "loan": {
      "month": 0,
      "type": "",
      "method": ""
    }
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_private/v2/ecommerce/order/:id/payment
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "paymentProvider": "",
        "successURL": "",
        "errorURL": "",
        "loan": {
          "month": 0,
          "type": "",
          "method": ""
        }
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
