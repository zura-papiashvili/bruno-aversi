meta {
  name: Get profile basic by id (GET)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api_admin/v1/project/:projectId/ecommerce/profile/:userId/basic
  body: none
  auth: apikey
}

params:path {
  userId: 
  projectId: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_admin/v1/project/:projectId/ecommerce/profile/:userId/basic
    method: GET
    mode: none
    params:path: {
      userId: 
      projectId: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "data": {
            "userId": ""
          }
        }
      '''
    }
  }
}

