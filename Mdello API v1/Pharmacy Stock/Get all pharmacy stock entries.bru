meta {
  name: Get all pharmacy stock entries
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api_admin/v1/pharmacy-stock
  body: none
  auth: inherit
}

params:query {
  ~limit: 
  ~page: 
  ~sortBy: 
  ~sortOrder: 
  ~search: 
  ~pharmacyId: 
  ~customerLongitude: 
  ~customerLatitude: 
  ~pharmacyIsActive: 
  ~showEmptyStocks: 
  ~excludePharmacyId: 
  ~excludeZoneId: 
  ~zoneId: 
  ~regionId: 
  ~productId: 
  ~stockMin: 
  ~stockMax: 
}

example {
  name: 200 Response
  description: List of all stock entries.
  
  request: {
