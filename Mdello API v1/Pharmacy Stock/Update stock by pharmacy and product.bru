meta {
  name: Update stock by pharmacy and product
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api_admin/v1/pharmacy-stock/pharmacy/:pharmacyId/product/:productId
  body: json
  auth: inherit
}

params:path {
  pharmacyId: 
  productId: 
}

body:json {
  {
    "stock": 0,
    "pharmacyId": 0,
    "productId": 0
  }
}

example {
  name: 200 Response
  description: Stock updated for specific pharmacy and product.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/pharmacy-stock/pharmacy/:pharmacyId/product/:productId
    method: PUT
    mode: json
    params:path: {
      pharmacyId: 
      productId: 
    }
  
    body:json: {
      {
        "stock": 0,
        "pharmacyId": 0,
        "productId": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "pharmacy": {
            "id": 0,
            "name": "",
            "old_name": "",
            "is_pickup": false,
            "is_delivery": false,
            "address": "",
            "longitude": 0,
            "latitude": 0,
            "schedule": {},
            "delivery_zones": [
              {
                "id": 0,
                "name": "",
                "region": {
                  "id": 0,
                  "name": ""
                }
              }
            ],
            "pickup_zones": [
              {}
            ],
            "distanceMeters": 0
          },
          "product": {
            "id": 0,
            "name": "",
            "code": ""
          },
          "stock": 0,
          "createdAt": "",
          "updatedAt": "",
          "deletedAt": ""
        }
      '''
    }
  }
}
