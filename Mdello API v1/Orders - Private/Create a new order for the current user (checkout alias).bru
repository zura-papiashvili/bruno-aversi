meta {
  name: Create a new order for the current user (checkout alias)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api_private/v1/orders/checkout
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
  x-private-api-key: eaba78b7b55c3e8f3e39f47359647dd01b112c55342257a4
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "orderItems": [
      {
        "productId": 12605,
        "quantity": 1
      },
      {
        "productId": 12944,
        "quantity": 1
      },
      {
        "productId": 13922,
        "quantity": 1
      },
      {
        "productId": 12540,
        "quantity": 1
      }
    ],
    "customerComment": "სსს",
    "pharmacyId": 1,
    "deliveryPrice": 7.29,
    "paymentMethodId": 18,
    "deliveryMethodId": 2,
    "latitude": 41.736311398869844,
    "longitude": 44.82156473775099,
    "customerZoneId": 23,
    "deliveryTime": null,
    "address": "24/27 ხერთვისის ქუჩა",
    "expectedTotalAmount":27.35,
    "customerPhone": "+995599955936"
  }
}

vars:pre-request {
  baseUrl: http://localhost:4000
}

example {
  name: 201 Response
  description: Order created successfully.
  
  request: {
    url: {{baseUrl}}/api_private/v1/orders/checkout
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "customerFullName": "",
        "customerPhone": "",
        "address": "",
        "customerComment": "",
        "deliveryTime": "",
        "pharmacyId": 0,
        "deliveryPrice": 0,
        "deliveryGroupCount": 0,
        "paymentMethodId": 0,
        "deliveryMethodId": 0,
        "orderItems": [
          {
            "productId": 0,
            "quantity": 0
          }
        ],
        "latitude": 0,
        "longitude": 0,
        "customerZoneId": 0,
        "promoCode": "",
        "deliveryAddress": ""
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/orders/checkout
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "customerFullName": "",
        "customerPhone": "",
        "address": "",
        "customerComment": "",
        "deliveryTime": "",
        "pharmacyId": 0,
        "deliveryPrice": 0,
        "deliveryGroupCount": 0,
        "paymentMethodId": 0,
        "deliveryMethodId": 0,
        "orderItems": [
          {
            "productId": 0,
            "quantity": 0
          }
        ],
        "latitude": 0,
        "longitude": 0,
        "customerZoneId": 0,
        "promoCode": "",
        "deliveryAddress": ""
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
