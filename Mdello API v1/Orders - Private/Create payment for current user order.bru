meta {
  name: Create payment for current user order
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api_private/v1/orders/:id/payment
  body: json
  auth: apikey
}

params:path {
  id: 1109
}

headers {
  x-session-id: {{apiKey}}
  x-private-api-key: eaba78b7b55c3e8f3e39f47359647dd01b112c55342257a4
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "successURL": "https://aversi-front-t81n2.noxtton.com/checkout?payment=success",
    "errorURL": "https://aversi-front-t81n2.noxtton.com/checkout?payment=error",
    "paymentProvider": "FLITT",
    "currency": "GEL",
    "paymentMethodId": 18
  }
}

vars:pre-request {
  baseUrl: http://localhost:4000
}

example {
  name: 201 Response
  description: Payment link created successfully.
  
  request: {
    url: {{baseUrl}}/api_private/v1/orders/:id/payment
    method: POST
    mode: json
    params:path: {
      id: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "paymentProvider": "",
        "successURL": "",
        "errorURL": "",
        "loan": {
          "month": 0,
          "type": "",
          "method": ""
        }
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

