    }
  
    body:json: {
      {
        "paymentProvider": "",
        "successURL": "",
        "errorURL": "",
        "loan": {
          "month": 0,
          "type": "",
          "method": ""
        }
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
