meta {
  name: Create a new category
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_admin/v1/product-categories
  body: json
  auth: inherit
}

body:json {
  {
    "name": "",
    "parentId": 0,
    "iconUrl": "",
    "status": "",
    "deliveryMethodIds": [],
    "type": "",
    "paymentMethodIds": [],
    "customerGroupIds": [],
    "isPurchasable": false,
    "enableAddToCart": false,
    "enableAddToWishlist": false,
    "metaTitle": "",
    "metaDescription": "",
    "metaKeywordIds": []
  }
}

example {
  name: 201 Response
  description: The category has been successfully created.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/product-categories
    method: POST
    mode: json
    body:json: {
      {
        "name": "",
        "parentId": 0,
        "iconUrl": "",
        "status": "",
        "deliveryMethodIds": [],
        "type": "",
        "paymentMethodIds": [],
        "customerGroupIds": [],
        "isPurchasable": false,
        "enableAddToCart": false,
        "enableAddToWishlist": false,
        "metaTitle": "",
        "metaDescription": "",
        "metaKeywordIds": []
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "name": "",
          "parent": "",
          "sortOrder": 0,
          "mainCategoryProducts": [],
          "products": [],
          "iconUrl": "",
          "status": "",
          "deliveryMethods": [],
          "paymentMethods": [],
          "isPurchasable": false,
          "enableAddToCart": false,
          "enableAddToWishlist": false,
          "metaTitle": "",
          "metaDescription": "",
          "metaKeywords": [],
          "customerGroups": []
        }
      '''
    }
  }
}
