meta {
  name: Create a new order notification
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_admin/v1/order-notifications
  body: json
  auth: inherit
}

body:json {
  {
    "orderStatusId": 0,
    "notifyUser": false,
    "notifyAdmin": false,
    "sendEmail": false,
    "sendSms": false,
    "sendWeb": false,
    "text": ""
  }
}

