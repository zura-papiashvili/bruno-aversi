meta {
  name: Create order group
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api_private/v1/ecommerce/order-group
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "selectedItems": [
      {
        "itemId": "",
        "quantity": 0,
        "selectedOption": {
          "_id": ""
        }
      }
    ],
    "dropoffAddress": {
      "name": "",
      "city": "",
      "street": "",
      "apartment": "",
      "phone_number": {
        "selected_country": "",
        "country_code": "",
        "number": ""
      },
      "coords": {
        "lat": 0,
        "lng": 0
      },
      "additional_comment": "",
      "_id": ""
    },
    "promoCode": ""
  }
}

