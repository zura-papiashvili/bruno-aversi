meta {
  name: List nearest coverage areas (zones and regions) from coordinates
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api_public/v1/order-assignments/location/nearest-coverage
  body: json
  auth: inherit
}

body:json {
  {
    "customerLatitude": 0,
    "customerLongitude": 0
  }
}

