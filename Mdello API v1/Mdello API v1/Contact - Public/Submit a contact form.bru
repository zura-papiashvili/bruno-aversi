meta {
  name: Submit a contact form
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_public/v1/contact
  body: json
  auth: apikey
}

headers {
  x-api-key: {{apiKey}}
}

auth:apikey {
  key: x-api-key
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "name": "",
    "email": "",
    "phone": "",
    "department": "",
    "submitterType": "",
    "file": "",
    "isConfidential": false,
    "message": ""
  }
}

example {
  name: 201 Response
  description: Contact successfully created
  
  request: {
    url: {{baseUrl}}/api_public/v1/contact
    method: POST
    mode: json
    headers: {
      x-api-key: {{apiKey}}
    }
  
    body:json: {
      {
        "name": "",
        "email": "",
        "phone": "",
        "department": "",
        "submitterType": "",
        "file": "",
        "isConfidential": false,
        "message": ""
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Project Token
  
  request: {
    url: {{baseUrl}}/api_public/v1/contact
    method: POST
    mode: json
    headers: {
      x-api-key: {{apiKey}}
    }
  
    body:json: {
      {
        "name": "",
        "email": "",
        "phone": "",
        "department": "",
        "submitterType": "",
        "file": "",
        "isConfidential": false,
        "message": ""
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
