meta {
  name: Create a new action
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api_private/v1/request-action
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "category": "",
    "description": "",
    "metadata": {
      "project": "",
      "apartmentNumber": "",
      "photos": []
    },
    "data": ""
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/request-action
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "category": "",
        "description": "",
        "metadata": {
          "project": "",
          "apartmentNumber": "",
          "photos": []
        },
        "data": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "project": "",
          "user": "",
          "category": "",
          "description": "",
          "metadata": {
            "project": "",
            "apartmentNumber": "",
            "photos": []
          },
          "data": ""
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_private/v1/request-action
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "category": "",
        "description": "",
        "metadata": {
          "project": "",
          "apartmentNumber": "",
          "photos": []
        },
        "data": ""
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
