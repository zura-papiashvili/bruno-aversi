meta {
  name: Get comments for a specific entity
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api_admin/v1/comments/:entityType/:entityId
  body: none
  auth: inherit
}

params:path {
  entityType: 
  entityId: 
}

