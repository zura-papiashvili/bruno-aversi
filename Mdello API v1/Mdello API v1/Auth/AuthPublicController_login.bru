meta {
  name: AuthPublicController_login
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api_public/v1/auth/login
  body: json
  auth: apikey
}

headers {
  x-api-key: {{apiKey}}
}

auth:apikey {
  key: x-api-key
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "email": "",
    "phone": "",
    "password": ""
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_public/v1/auth/login
    method: POST
    mode: json
    headers: {
      x-api-key: {{apiKey}}
    }
  
    body:json: {
      {
        "email": "",
        "phone": "",
        "password": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {}
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api_public/v1/auth/login
    method: POST
    mode: json
    headers: {
      x-api-key: {{apiKey}}
    }
  
    body:json: {
      {
        "email": "",
        "phone": "",
        "password": ""
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
