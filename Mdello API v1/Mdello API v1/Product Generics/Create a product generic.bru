meta {
  name: Create a product generic
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_admin/v1/product-generics
  body: json
  auth: inherit
}

body:json {
  {
    "name": "",
    "erpId": 0
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api_admin/v1/product-generics
    method: POST
    mode: json
    body:json: {
      {
        "name": "",
        "erpId": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "name": "",
          "erpId": 0,
          "products": [],
          "createdAt": "",
          "updatedAt": "",
          "deletedAt": ""
        }
      '''
    }
  }
}
