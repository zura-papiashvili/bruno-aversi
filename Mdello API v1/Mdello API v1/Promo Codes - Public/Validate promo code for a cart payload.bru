meta {
  name: Validate promo code for a cart payload
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_public/v1/promo-codes/validate
  body: json
  auth: inherit
}

body:json {
  {
    "promoCode": "",
    "code": "",
    "items": [
      {
        "productId": 0,
        "price": 0,
        "quantity": 0
      }
    ]
  }
}

example {
  name: 200 Response
  description: Promo code validation result with discount calculation.
  
  request: {
    url: {{baseUrl}}/api_public/v1/promo-codes/validate
    method: POST
    mode: json
    body:json: {
      {
        "promoCode": "",
        "code": "",
        "items": [
          {
            "productId": 0,
            "price": 0,
            "quantity": 0
          }
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "promoCodeId": 0,
          "code": "",
          "discountType": "",
          "discountValue": 0,
          "subtotal": 0,
          "discountAmount": 0,
          "total": 0
        }
      '''
    }
  }
}

