meta {
  name: Generate delivery method recommendations for public checkout
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_public/v1/order-assignments/recommend
  body: json
  auth: inherit
}

body:json {
  {
    "products": [
      {
        "productId": 0,
        "quantity": 0
      }
    ],
    "customerRegionId": 0,
    "customerZoneId": 0,
    "customerLatitude": 0,
    "customerLongitude": 0,
    "deliveryMethodTypes": [],
    "useGoogleMapsDistance": false
  }
}

