meta {
  name: Get all pharmacies
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api_admin/v1/pharmacies
  body: none
  auth: inherit
}

params:query {
  ~limit: 
  ~page: 
  ~sortBy: 
  ~sortOrder: 
  ~search: 
  ~name: 
  ~address: 
  ~is_active: 
  ~is_delivery: 
  ~is_pickup: 
  ~region_id: 
  ~zone_id: 
  ~unique_code: 
