  ~site_code: 
  ~cod_ave: 
  ~delivery_priority: 
}

example {
  name: 200 Response
  description: List of pharmacies.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/pharmacies
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~sortBy: 
      ~sortOrder: 
      ~search: 
      ~name: 
      ~address: 
      ~is_active: 
      ~is_delivery: 
      ~is_pickup: 
      ~region_id: 
      ~zone_id: 
      ~unique_code: 
      ~internal_code: 
      ~site_code: 
      ~cod_ave: 
      ~delivery_priority: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "id": 0,
            "name": "",
            "old_name": "",
            "address": "",
