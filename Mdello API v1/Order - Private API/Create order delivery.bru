meta {
  name: Create order delivery
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/ecommerce/order/:orderId/delivery
  body: none
  auth: apikey
}

params:path {
  orderId: 
}

headers {
  x-private-api-key: {{apiKey}}
}

auth:apikey {
  key: x-private-api-key
  value: {{apiKey}}
  placement: header
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api/v1/ecommerce/order/:orderId/delivery
    method: POST
    mode: none
    params:path: {
      orderId: 
    }
  
    headers: {
      x-private-api-key: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "data": {
            "msg": "",
            "code": 0,
            "id": 0
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Private API key
  
  request: {
    url: {{baseUrl}}/api/v1/ecommerce/order/:orderId/delivery
    method: POST
    mode: none
    params:path: {
      orderId: 
    }
  
    headers: {
      x-private-api-key: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
