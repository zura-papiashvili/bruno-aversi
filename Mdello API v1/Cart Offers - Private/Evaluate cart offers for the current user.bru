meta {
  name: Evaluate cart offers for the current user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_private/v1/cart-offers/evaluate
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
  x-private-api-key: eaba78b7b55c3e8f3e39f47359647dd01b112c55342257a4
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "lines": [
      {
        "productId": 13922,
        "quantity": 1
      },
      {
        "productId": 99212,
        "quantity": 1
      }
    ],
    "userOrderCount": 0,
    "customerGroupIds": [
      4
    ],
    "regionId": 9,
    "countryCode": "GE",
    "deliveryMethodId": 1,
    "promoCode": "",
    "featureIds": [],
    "featureValueIds": [],
    "featureValues": []
  }
}

vars:pre-request {
  baseUrl: http://localhost:4000
}

example {
  name: 200 Response
  description: Cart offer evaluation result.
  
  request: {
    url: {{baseUrl}}/api_private/v1/cart-offers/evaluate
