meta {
  name: Update sync settings
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api_admin/v1/sync-settings
  body: json
  auth: inherit
}

body:json {
  {
    "syncProducts": false,
    "syncCategories": false,
    "syncPharmacies": false,
    "syncZones": false,
    "syncRegions": false
  }
}

example {
  name: 200 Response
  description: The updated sync settings
  
  request: {
    url: {{baseUrl}}/api_admin/v1/sync-settings
    method: PUT
    mode: json
    body:json: {
      {
        "syncProducts": false,
        "syncCategories": false,
        "syncPharmacies": false,
        "syncZones": false,
        "syncRegions": false
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "syncProducts": false,
          "syncCategories": false,
          "syncPharmacies": false,
          "syncZones": false,
          "syncRegions": false,
          "createdAt": "",
          "updatedAt": "",
          "deletedAt": ""
        }
      '''
    }
  }
}
