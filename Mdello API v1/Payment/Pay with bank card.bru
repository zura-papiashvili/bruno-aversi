meta {
  name: Pay with bank card
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api_private/v1/payment/payWithCard
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "amount": 0,
    "currency": "",
    "bankCardId": 0,
    "preauthorize": false,
    "purchaseUnits": [
      {
        "type": "",
        "id": "",
        "amount": 0,
        "quantity": 0,
        "discount": 0
      }
    ],
    "successURL": "",
    "errorURL": "",
    "merchantId": "",
    "isTestTransaction": false
  }
}

