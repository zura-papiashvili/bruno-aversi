meta {
  name: Update the bank card data
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api_private/v1/payment/bankCard/:id
  body: json
  auth: apikey
}

params:path {
  id: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "name": ""
  }
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_private/v1/payment/bankCard/:id
    method: PUT
    mode: json
    params:path: {
      id: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "name": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "provider": "",
          "id": 0,
          "externalProjectId": "",
          "externalUserId": "",
          "status": "",
          "mask": "",
          "name": "",
          "isDefault": false,
          "externalCardId": "",
          "externalTransactionId": "",
          "transactionId": "",
          "externalTransactionUrl": "",
          "merchantId": "",
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

