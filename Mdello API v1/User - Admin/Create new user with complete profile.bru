meta {
  name: Create new user with complete profile
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api_admin/v1/auth/user
  body: json
  auth: apikey
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "fullName": "",
    "firstName": "",
    "lastName": "",
    "username": "",
    "idNumber": "",
    "phone": "",
    "email": "",
    "imageUrl": "",
    "password": "",
    "addresses": [
      {
        "title": "",
        "firstName": "",
        "lastName": "",
        "phone": "",
        "phoneSuffix": "",
        "address": "",
        "zoneId": 0,
        "latitude": 0,
        "longitude": 0,
        "comment": "",
        "isPrimary": false,
        "region": "",
        "zone": ""
      }
    ],
    "metadata": {},
    "showMarketingField": false
  }
}

example {
  name: 201 Response
  description: User created successfully
  
  request: {
    url: {{baseUrl}}/api_admin/v1/auth/user
    method: POST
    mode: json
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "fullName": "",
        "firstName": "",
        "lastName": "",
        "username": "",
        "idNumber": "",
        "phone": "",
        "email": "",
        "imageUrl": "",
        "password": "",
        "addresses": [
          {
            "title": "",
            "firstName": "",
            "lastName": "",
            "phone": "",
            "phoneSuffix": "",
            "address": "",
            "zoneId": 0,
            "latitude": 0,
            "longitude": 0,
            "comment": "",
            "isPrimary": false,
            "region": "",
            "zone": ""
          }
        ],
        "metadata": {},
        "showMarketingField": false
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "",
          "fullName": "",
          "firstName": "",
          "lastName": "",
          "username": "",
          "idNumber": "",
          "phone": "",
          "email": "",
          "project": "",
          "isEmailVerified": false,
          "isPhoneVerified": false,
          "addresses": [
            {
              "title": "",
              "firstName": "",
              "lastName": "",
              "phone": "",
              "phoneSuffix": "",
              "address": "",
              "zoneId": 0,
              "latitude": 0,
              "longitude": 0,
              "comment": "",
              "isPrimary": false,
              "region": "",
              "zone": ""
            }
          ],
          "metadata": {},
          "createdAt": "",
          "updatedAt": "",
          "customerGroup": "",
          "showMarketingField": false,
          "imageUrl": "",
          "zone": ""
        }
      '''
    }
  }
}

