meta {
  name: Update the user
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api_admin/v1/auth/user/:id
  body: json
  auth: apikey
}

params:path {
  id: 
}

headers {
  x-session-id: {{apiKey}}
}

auth:apikey {
  key: x-session-id
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "fullName": "",
    "firstName": "",
    "lastName": "",
    "email": "",
    "phone": "",
    "imageUrl": "",
    "username": "",
    "idNumber": "",
    "password": "",
    "addresses": [
      {}
    ],
    "metadata": {},
    "showMarketingField": false,
    "isEmailVerified": false,
    "isPhoneVerified": false
  }
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api_admin/v1/auth/user/:id
    method: PUT
    mode: json
    params:path: {
      id: 
    }
  
    headers: {
      x-session-id: {{apiKey}}
    }
  
    body:json: {
      {
        "fullName": "",
        "firstName": "",
        "lastName": "",
        "email": "",
        "phone": "",
        "imageUrl": "",
        "username": "",
        "idNumber": "",
        "password": "",
        "addresses": [
          {}
        ],
        "metadata": {},
        "showMarketingField": false,
        "isEmailVerified": false,
        "isPhoneVerified": false
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

