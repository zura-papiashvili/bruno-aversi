meta {
  name: Create a new region
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api_admin/v1/regions
  body: json
  auth: inherit
}

body:json {
  {
    "name": "",
    "code": "",
    "country": "",
    "is_active": false,
    "priority": 0
  }
}

example {
  name: 201 Response
  description: The region has been successfully created.
  
  request: {
    url: {{baseUrl}}/api_admin/v1/regions
    method: POST
    mode: json
    body:json: {
      {
        "name": "",
        "code": "",
        "country": "",
        "is_active": false,
        "priority": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "name": "",
          "code": "",
          "country": "",
          "is_active": false,
          "priority": 0,
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}
