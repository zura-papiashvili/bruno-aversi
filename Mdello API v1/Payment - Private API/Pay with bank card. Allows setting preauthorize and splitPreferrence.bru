meta {
  name: Pay with bank card. Allows setting preauthorize and splitPreferrence
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/payment/payWithCard
  body: none
  auth: apikey
}

headers {
  x-private-api-key: {{apiKey}}
}

auth:apikey {
  key: x-private-api-key
  value: {{apiKey}}
  placement: header
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api/v1/payment/payWithCard
    method: POST
    mode: none
    headers: {
      x-private-api-key: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "transaction": {
            "provider": "",
            "id": 0,
            "externalProjectId": "",
            "externalUserId": "",
            "source": "",
            "externalTransactionId": "",
            "transactionId": "",
            "bankCard": {
              "provider": "",
              "id": 0,
              "externalProjectId": "",
              "externalUserId": "",
              "status": "",
              "mask": "",
              "name": "",
              "isDefault": false,
              "externalCardId": "",
              "externalTransactionId": "",
              "transactionId": "",
              "externalTransactionUrl": "",
              "merchantId": "",
              "createdAt": "",
              "updatedAt": ""
            },
            "status": "",
            "blockedAmount": 0,
            "amount": 0,
            "fee": 0,
            "feeDiscount": 0,
            "splitCommission": 0,
            "finalAmount": 0,
            "refundAmount": 0,
            "currency": "",
            "purchaseUnits": {},
            "splitPreferrence": [
              {
                "amount": 0,
                "percent": 0,
                "iban": "",
                "description": ""
              }
            ],
            "config": {},
            "isSuccessExecuted": false,
            "merchantId": "",
            "createdAt": "",
            "updatedAt": ""
          },
          "success": false
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing Token or Session ID
  
  request: {
    url: {{baseUrl}}/api/v1/payment/payWithCard
    method: POST
    mode: none
    headers: {
      x-private-api-key: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
